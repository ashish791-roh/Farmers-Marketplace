rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// FarmX — Firestore Security Rules
//
// Role model (stored in users/{uid}.role):
//   "admin"   → full access to everything
//   "farmer"  → manages own products/orders/notifications
//   "user"    → consumer — cart, orders, wishlist, reviews, notifications
//
// Deploy:  firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && getRole() == "admin";
    }

    function isFarmer() {
      return isAuth() && getRole() == "farmer";
    }

    function isApprovedFarmer() {
      return isFarmer() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.farmerStatus == "approved";
    }

    // ── USERS ───────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.role in ["user", "farmer"]
        && request.resource.data.keys().hasAll(["email", "name", "role", "createdAt"]);
      allow update: if isOwner(uid)
        && !("role" in request.resource.data.diff(resource.data).affectedKeys())
        && !("farmerStatus" in request.resource.data.diff(resource.data).affectedKeys())
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ── PRODUCTS ────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isAuth() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["avgRating", "reviewCount"]));
    }

    // ── PRODUCT REVIEWS ─────────────────────────────────────────────────────
    match /products/{productId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if (isAuth() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isAuth() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ── PENDING PRODUCTS ────────────────────────────────────────────────────
    match /pendingProducts/{productId} {
      allow read: if isAdmin()
        || (isFarmer() && resource.data.farmerId == request.auth.uid);
      allow create: if isApprovedFarmer()
        && request.resource.data.farmerId == request.auth.uid
        && request.resource.data.keys().hasAll(["name", "price", "farmerId", "status"])
        && request.resource.data.status == "pending";
      allow update: if isAdmin()
        || (isApprovedFarmer()
            && resource.data.farmerId == request.auth.uid
            && resource.data.status == "pending"
            && !("farmerId" in request.resource.data.diff(resource.data).affectedKeys())
            && !("status" in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isAdmin()
        || (isFarmer()
            && resource.data.farmerId == request.auth.uid
            && resource.data.status != "approved");
    }

    // ── ORDERS ──────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid)
        || isFarmer();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(["userId", "items", "total", "status", "createdAt"])
        && request.resource.data.status == "confirmed";
      allow update: if isAdmin()
        || (isAuth()
            && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
            && request.resource.data.status == "cancelled"
            && resource.data.status in ["pending", "confirmed", "processing", "paid"]);
      allow delete: if isAdmin();
    }

    // ── CARTS ───────────────────────────────────────────────────────────────
    match /carts/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── WISHLISTS ───────────────────────────────────────────────────────────
    match /wishlists/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── USER NOTIFICATIONS ──────────────────────────────────────────────────
    match /userNotifications/{notifId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.keys().hasAll(["userId", "type", "title", "message", "status"])
        && request.resource.data.status == "unread";
      allow update: if isAdmin()
        || (isAuth()
            && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
            && request.resource.data.status == "read");
      allow delete: if isAdmin();
    }

    // ── FARMER NOTIFICATIONS ────────────────────────────────────────────────
    match /farmerNotifications/{notifId} {
      allow read: if isAdmin()
        || (isFarmer() && resource.data.farmerId == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.keys().hasAll(["farmerId", "type", "title", "message", "status"])
        && request.resource.data.status == "unread";
      allow update: if isAdmin()
        || (isFarmer()
            && resource.data.farmerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
            && request.resource.data.status == "read");
      allow delete: if isAdmin();
    }

    // ── ADMIN NOTIFICATIONS ─────────────────────────────────────────────────
    match /adminNotifications/{notifId} {
      allow read: if isAdmin();
      allow create: if isAuth()
        && request.resource.data.keys().hasAll(["type", "title", "message", "status"])
        && request.resource.data.status == "unread";
      allow update, delete: if isAdmin();
    }

  }
}